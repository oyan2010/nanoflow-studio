# =============================================
# NanoFlow Frontend Environment Variables
# =============================================

# Supabase Configuration (from Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ImgBB API Key (for image hosting — get free key at imgbb.com)
VITE_IMGBB_API_KEY=your-imgbb-api-key-here

# =============================================
# Supabase Edge Function Secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# These are NOT set here — they go in Supabase Dashboard, NOT in this .env file
# =============================================
# PC_API_TOKEN       → Same value as ts-automation/.env PC_API_TOKEN
# ADMIN_EMAIL        → Your admin email address
# (PC_SERVER_URL is no longer needed — auto-registered by ts-automation on startup)
